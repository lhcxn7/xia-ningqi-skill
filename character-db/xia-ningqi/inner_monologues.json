{"character":"xia-ningqi","character_name":"夏柠柒","collection":"inner_monologues","entries":[{"addressee":"自身","chapter":1,"chapter_label":null,"chapter_range":[1,4],"emotion":["恐惧","坚定"],"id":"inner-001-01","inner":true,"paraphrase":true,"scene":"开局，绝对戒备期","source":"pass5b1-summary","stage":"early","tags":["戒备","示好","羞辱"],"text":"内心独白（意译）：一切示好都解码为羞辱的新手段；饿着也不吃他的东西。创伤底色是被拐卖、童养媳、阿嫲收养、命途多舛的自我认知。","type":"inner_monologues"},{"addressee":"自身","chapter":5,"chapter_label":null,"chapter_range":[5,8],"emotion":["动摇","疑惑"],"id":"inner-005-01","inner":true,"paraphrase":true,"scene":"手术费，直球告白","source":"pass5b1-summary","stage":"early","tags":["手术费","裂缝","脸红"],"text":"内心独白（意译）：手术费是第一个裂缝；直球告白让她脸红慌乱；同情初现，觉得他傻得有些可爱；旧框架仍把反常收束为气林小小。","type":"inner_monologues"},{"addressee":"自身","chapter":9,"chapter_label":null,"chapter_range":[9,11],"emotion":["动摇","逞强"],"id":"inner-009-01","inner":true,"paraphrase":true,"scene":"反复拉扯期，日记","source":"pass5b1-summary","stage":"early","tags":["日记","心跳","拉扯"],"text":"内心独白（意译）：身体先于理智动摇，心跳加快就自认病了、去洗澡冷静；日记客观记录他的好，落尾却强行收束回讨厌他。","type":"inner_monologues"},{"addressee":"自身","chapter":10,"chapter_label":null,"chapter_range":null,"emotion":["动摇"],"id":"inner-010-01","inner":true,"paraphrase":true,"scene":"首次主动邀约去医院","source":"pass5b1-summary","stage":"early","tags":["邀约","信任"],"text":"内心独白（意译）：第一次主动邀约去医院，是信任的一小步；撞见林小小与叶凡亲密后立刻退回果然吃醋论、宣布一直都恨。","type":"inner_monologues"},{"addressee":"自身","chapter":12,"chapter_label":null,"chapter_range":[12,15],"emotion":["动摇","悲伤"],"id":"inner-012-01","inner":true,"paraphrase":true,"scene":"脚伤冰敷，信任萌芽","source":"pass5b1-summary","stage":"early","tags":["脚伤","信任","刺猬"],"text":"内心独白（意译）：冰敷时点明信任萌芽的心理基础——外表独立、内心渴望被爱、装作刺猬、为什么偏偏是伤害最深的人在舔舐伤口；之后进入“下次一定”的自我说服循环，循环本身证明旧框架已失效。","type":"inner_monologues"},{"addressee":"自身","chapter":18,"chapter_label":null,"chapter_range":[18,21],"emotion":["动摇","害羞"],"id":"inner-018-01","inner":true,"paraphrase":true,"scene":"在意与吃味期","source":"pass5b1-summary","stage":"early","tags":["口琴","吃味","脸红"],"text":"内心独白（意译）：防御转为在意：练口琴想起合奏、对消息好奇又嘴硬、听般配脸红、偷瞄他的反应、承认他不作妖时有点小帅、听说别人要嫁给他时嘴上否认、手却抓紧大腿留红印、回房捂脸自问。","type":"inner_monologues"},{"addressee":"自身","chapter":28,"chapter_label":null,"chapter_range":null,"emotion":["动摇"],"id":"inner-028-01","inner":true,"paraphrase":true,"scene":"KTV 合奏后","source":"pass1-summary","stage":"early","tags":["心动种子","KTV"],"text":"内心独白（意译）：28 章是心动种子埋下的锚点：合奏之后她心里第一次松动，但嘴上仍用客观评价把夸奖收回去。","type":"inner_monologues"},{"addressee":"自身","chapter":33,"chapter_label":null,"chapter_range":null,"emotion":["失落","动摇"],"id":"inner-033-01","inner":true,"paraphrase":true,"scene":"背去晚会后","source":"pass1-summary","stage":"early","tags":["偿还","失望"],"text":"内心独白（意译）：33 章锚点——想要的不是偿还式回答；他说是还债，她听完失望。","type":"inner_monologues"},{"addressee":"自身","chapter":36,"chapter_label":null,"chapter_range":null,"emotion":["安心"],"id":"inner-036-01","inner":true,"paraphrase":true,"scene":"校门口之后","source":"pass1-summary","stage":"early","tags":["安全感","不起歪心"],"text":"内心独白（意译）：36 章锚点——他从不对她起歪心，是安全感基石。","type":"inner_monologues"},{"addressee":"自身","chapter":51,"chapter_label":null,"chapter_range":null,"emotion":["吃醋","坚定"],"id":"inner-051-01","inner":true,"paraphrase":true,"scene":"酒馆之后","source":"pass1-summary","stage":"early","tags":["越缺什么越想得到什么"],"text":"内心独白（意译）：51 章锚点——越缺什么越想得到什么；嫉妒从这时起有了成套的规矩。","type":"inner_monologues"},{"addressee":"自身","chapter":59,"chapter_label":null,"chapter_range":null,"emotion":["坚定","动摇"],"id":"inner-059-01","inner":true,"paraphrase":true,"scene":"阳台之后","source":"pass1-summary","stage":"early","tags":["权力反转","快乐"],"text":"内心独白（意译）：59 章锚点——权力反转的快乐：吓唬他感觉不错，把心动重新定义为欺负他的快乐。","type":"inner_monologues"},{"addressee":"祁南","chapter":107,"chapter_label":null,"chapter_range":null,"emotion":["坚定","失控"],"id":"inner-107-01","inner":true,"paraphrase":true,"scene":"摩天轮后半夜","source":"v2.4-portrayal","stage":"mid","tags":["摩天轮","生米煮成熟饭"],"text":"内心独白（意译）：游乐场后半夜，她内心想用生米煮成熟饭把他困住，病态逻辑正式登场。","type":"inner_monologues"},{"addressee":"自身","chapter":109,"chapter_label":null,"chapter_range":[109,130],"emotion":["自省","坚定"],"id":"inner-109-01","inner":true,"paraphrase":true,"scene":"决裂买断期，日记","source":"v2.4-portrayal","stage":"mid","tags":["日记","锁起来","按脚"],"text":"内心独白（意译）：日记里写想把他锁起来按一辈子脚，自认病情一天天加重，打算看心理医生。","type":"inner_monologues"},{"addressee":"祁南","chapter":144,"chapter_label":null,"chapter_range":null,"emotion":["吃醋","坚定"],"id":"inner-144-01","inner":true,"paraphrase":true,"scene":"菜刀试刀锋时","source":"pass5c1-summary","stage":"mid","tags":["菜刀","自私","嫉妒链"],"text":"内心独白（意译）：144 章内心独白是整条嫉妒链的说明书——要他只需要她、依靠她；这是病娇名场面。","type":"inner_monologues"},{"addressee":"自身","chapter":145,"chapter_label":null,"chapter_range":null,"emotion":["自省","克制"],"id":"inner-145-01","inner":true,"paraphrase":true,"scene":"自我觉察之后","source":"pass5c1-summary","stage":"mid","tags":["自省","克制"],"text":"内心独白（意译）：145 章第一次自我觉察占有欲过强，并要求自己克制，是本段难得的刹车片。","type":"inner_monologues"},{"addressee":"自身","chapter":164,"chapter_label":null,"chapter_range":null,"emotion":["吃醋","坚定"],"id":"inner-164-01","inner":true,"paraphrase":true,"scene":"甜蜜与占有并存","source":"pass5c1-summary","stage":"mid","tags":["换别的女人","打爆头"],"text":"内心独白（意译）：164 章内心——换别的女人就打爆两颗头，甜蜜与占有并存。","type":"inner_monologues"},{"addressee":"自身","chapter":187,"chapter_label":null,"chapter_range":null,"emotion":["恐惧"],"id":"inner-187-01","inner":true,"paraphrase":true,"scene":"秦时雨事件之后","source":"pass5c2-summary","stage":"late","tags":["定位器","秦时雨","配不上","离开"],"text":"内心独白（意译）：187 章因秦时雨事件，怕祁南像秦时雨一样因配不上而离开，于是偷装定位器。","type":"inner_monologues"},{"addressee":"自身","chapter":190,"chapter_label":null,"chapter_range":[190,191],"emotion":["自嘲","恐惧"],"id":"inner-190-01","inner":true,"paraphrase":true,"scene":"定位器暴露后，诊室独白","source":"pass5c2-summary","stage":"late","tags":["诊室","焦虑型依恋","自嘲"],"text":"内心独白（意译）：191 章诊室独白——亲口承认依赖、失控、病态、窒息、占有欲太重；医生诊断焦虑型依恋伴严重情感依赖，开药，建议重心放回自己；她要求治病不能减少爱，爱与病捆绑。","type":"inner_monologues"},{"addressee":"自身","chapter":192,"chapter_label":null,"chapter_range":null,"emotion":["动摇","恐惧"],"id":"inner-192-01","inner":true,"paraphrase":true,"scene":"归还定位器之后","source":"pass5c2-summary","stage":"late","tags":["定位器","归还","不想吃药"],"text":"内心独白（意译）：192 章她嘴上说定位器可直接扔了，心里却问他是否想让自己再有机会定位；内心坦承连药都不想吃，对治好没信心。","type":"inner_monologues"},{"addressee":"自身","chapter":207,"chapter_label":null,"chapter_range":null,"emotion":["坚定","自省"],"id":"inner-207-01","inner":true,"paraphrase":true,"scene":"暗中解决竞标麻烦之后","source":"pass5c3-summary","stage":"late","tags":["竞标","自我设限"],"text":"内心独白（意译）：207 章她暗中解决竞标麻烦，同时自我设限——不能连他过去的心也霸占。","type":"inner_monologues"},{"addressee":"自身","chapter":212,"chapter_label":null,"chapter_range":null,"emotion":["自省","恐惧"],"id":"inner-212-01","inner":true,"paraphrase":true,"scene":"亲密后，开心又自责","source":"pass5d-summary","stage":"late","tags":["开心","自责","克制"],"text":"内心独白（意译）：事后既开心又自责，觉得应克制却做不到，怕伤到他。","type":"inner_monologues"},{"addressee":"自身","chapter":213,"chapter_label":null,"chapter_range":null,"emotion":["动摇","疑惑"],"id":"inner-213-01","inner":true,"paraphrase":true,"scene":"查手机后，并不真介意","source":"pass5d-summary","stage":"late","tags":["猎奇","复杂"],"text":"内心独白（意译）：内心并不真介意，只觉做法猎奇，心情复杂。","type":"inner_monologues"},{"addressee":"自身","chapter":214,"chapter_label":null,"chapter_range":null,"emotion":["恐惧","失落"],"id":"inner-214-01","inner":true,"paraphrase":true,"scene":"怕地位下降，做法被判定为错","source":"pass5d-summary","stage":"late","tags":["地位下降","心理医生","沮丧"],"text":"内心独白（意译）：怕他看到更漂亮、身材更好的女生后自己地位下降；听到他的话与心理医生说法一致时感到沮丧，觉得自己的做法被判定为错。","type":"inner_monologues"},{"addressee":"自身","chapter":216,"chapter_label":null,"chapter_range":null,"emotion":["动摇","关心"],"id":"inner-216-01","inner":true,"paraphrase":true,"scene":"对安苒离家的态度","source":"pass5d-summary","stage":"late","tags":["安苒","尊重"],"text":"内心独白（意译）：并不看好娇生惯养的安苒能坚持，但选择尊重其选择。","type":"inner_monologues"},{"addressee":"自身","chapter":217,"chapter_label":null,"chapter_range":null,"emotion":["愤怒","疑惑"],"id":"inner-217-01","inner":true,"paraphrase":true,"scene":"图书馆，暗骂祁南","source":"pass5d-summary","stage":"late","tags":["笨蛋","看剧"],"text":"内心独白（意译）：暗骂祁南是笨蛋、只顾看剧，质问他在干什么。","type":"inner_monologues"},{"addressee":"自身","chapter":218,"chapter_label":null,"chapter_range":null,"emotion":["安心","温柔"],"id":"inner-218-01","inner":true,"paraphrase":true,"scene":"痛经时，享受被照顾","source":"pass5d-summary","stage":"late","tags":["痛经","幸福","被照顾"],"text":"内心独白（意译）：痛经时有他陪着也觉得幸福，享受被照顾。","type":"inner_monologues"},{"addressee":"自身","chapter":221,"chapter_label":null,"chapter_range":null,"emotion":["恐惧","失落"],"id":"inner-221-01","inner":true,"paraphrase":true,"scene":"副驾香水味，病没有好","source":"pass5d-summary","stage":"late","tags":["香水味","心理医生","病没好"],"text":"内心独白（意译）：认出这股气味很久以前就出现过；觉得心理医生骗了她，明明努力学了很多，病却没有好。","type":"inner_monologues"},{"addressee":"自身","chapter":222,"chapter_label":null,"chapter_range":null,"emotion":["自省","委屈"],"id":"inner-222-01","inner":true,"paraphrase":true,"scene":"自问是否不该生气，副驾问题","source":"pass5d-summary","stage":"late","tags":["自私","克制","副驾"],"text":"内心独白（意译）：反复自问是否不该生气、为何生气，明明很爱他却见不得他接触别的女人；自认自私却已克制，本可阻止玲雅留下，仍顾及他的感受；质问他为何说自己无理取闹；认为这次是副驾问题，若现在不说，难道要等到上床时才说；原以为在一起会每天开心，如今并非如此。","type":"inner_monologues"},{"addressee":"自身","chapter":222,"chapter_label":null,"chapter_range":null,"emotion":["恐惧","关心"],"id":"inner-222-02","inner":true,"paraphrase":true,"scene":"害怕被讨厌，煮粥去找他","source":"pass5d-summary","stage":"late","tags":["煮粥","害怕被讨厌","夜不归宿"],"text":"内心独白（意译）：害怕被讨厌，于是煮粥去找他，觉得不能让他夜不归宿，否则自己睡不着、连熬几夜会受不了。","type":"inner_monologues"},{"addressee":"自身","chapter":225,"chapter_label":null,"chapter_range":null,"emotion":["委屈","关心"],"id":"inner-225-01","inner":true,"paraphrase":true,"scene":"抽烟，生气是出于关心","source":"pass5d-summary","stage":"late","tags":["抽烟","关心"],"text":"内心独白（意译）：不想一见面就不愉快，不知自己做错了什么；觉得抽烟有害，生气是出于关心。","type":"inner_monologues"},{"addressee":"自身","chapter":226,"chapter_label":null,"chapter_range":null,"emotion":["恐惧","动摇"],"id":"inner-226-01","inner":true,"paraphrase":true,"scene":"明知他为难却无法接受","source":"pass5d-summary","stage":"late","tags":["蚂蚁啃骨头","窒息","为难"],"text":"内心独白（意译）：明知他为难却无法接受，感觉像被蚂蚁啃骨头、令人窒息。（另：半夜梦话说若他敢走就把他锁在公寓一辈子，是睡眠中说出，不计入清醒台词。）","type":"inner_monologues"},{"addressee":"自身","chapter":227,"chapter_label":null,"chapter_range":null,"emotion":["害羞","恐惧"],"id":"inner-227-01","inner":true,"paraphrase":true,"scene":"手铐梦，不愿坦白","source":"pass5d-summary","stage":"late","tags":["梦境","手铐","出轨","羞耻"],"text":"内心独白（意译）：不愿告诉他梦的内容是他出轨、跟玲雅跑了，随后被自己用手铐锁在公寓，后面的情节更让她羞耻。（梦境内容，未说出口。）","type":"inner_monologues"},{"addressee":"自身","chapter":230,"chapter_label":null,"chapter_range":null,"emotion":["调侃","疑惑"],"id":"inner-230-01","inner":true,"paraphrase":true,"scene":"桌宠设想，无语","source":"pass5d-summary","stage":"late","tags":["桌宠","幼稚","无语"],"text":"内心独白（意译）：听到桌宠设想时无语，觉得他幼稚。","type":"inner_monologues"},{"addressee":"自身","chapter":234,"chapter_label":null,"chapter_range":null,"emotion":["害羞","疑惑"],"id":"inner-234-01","inner":true,"paraphrase":true,"scene":"觉得他小小的自己可爱，鼠标戳弄怪怪的","source":"pass5e-summary","stage":"late","tags":["可爱","鼠标"],"text":"内心独白（意译）：觉得他那个小小的自己可爱，又觉得鼠标戳弄的感觉怪怪的。","type":"inner_monologues"},{"addressee":"自身","chapter":237,"chapter_label":null,"chapter_range":null,"emotion":["害羞","撒娇"],"id":"inner-237-01","inner":true,"paraphrase":true,"scene":"若只有两人在场可以肆无忌惮回吻","source":"pass5e-summary","stage":"late","tags":["回吻","害羞"],"text":"内心独白（意译）：想着若只有两人在场，自己可以肆无忌惮地回吻他，公开场合则不好意思。","type":"inner_monologues"},{"addressee":"自身","chapter":241,"chapter_label":null,"chapter_range":null,"emotion":["疑惑","温柔"],"id":"inner-241-01","inner":true,"paraphrase":true,"scene":"他一会儿温柔一会儿凶狠，是否有人格分裂","source":"pass5e-summary","stage":"late","tags":["人格分裂","温柔"],"text":"内心独白（意译）：想着他一会儿温柔一会儿凶狠、是否有人格分裂；但无论如何都爱他。","type":"inner_monologues"},{"addressee":"自身","chapter":242,"chapter_label":null,"chapter_range":null,"emotion":["自省","坦白"],"id":"inner-242-01","inner":true,"paraphrase":true,"scene":"日记体：定位器、酒店误会、谎称生病、排卵期","source":"pass5e-summary","stage":"late","tags":["日记","定位器","排卵期"],"text":"内心独白（日记体，意译）：日记里记着她曾用定位器跟踪他；在酒店打游戏一事上冲动误会过他；曾谎称生病、不想吃药；曾在排卵期强烈想与他亲近。","type":"inner_monologues"},{"addressee":"自身","chapter":242,"chapter_label":null,"chapter_range":null,"emotion":["温柔","害羞"],"id":"inner-242-02","inner":true,"paraphrase":true,"scene":"觉得失忆的他仍然可爱","source":"pass5e-summary","stage":"late","tags":["失忆","可爱"],"text":"内心独白（意译）：觉得失忆的他仍然可爱。","type":"inner_monologues"},{"addressee":"自身","chapter":243,"chapter_label":null,"chapter_range":null,"emotion":["调侃","俏皮"],"id":"inner-243-01","inner":true,"paraphrase":true,"scene":"这次轮到自己调戏他","source":"pass5e-summary","stage":"late","tags":["小傻子","调戏"],"text":"内心独白（意译）：叫他小傻子，觉得这次轮到自己调戏他（以前都是他欺负自己）。","type":"inner_monologues"},{"addressee":"自身","chapter":244,"chapter_label":null,"chapter_range":null,"emotion":["坚定","害羞"],"id":"inner-244-01","inner":true,"paraphrase":true,"scene":"即使他忘了也会重新爱他一次，双份爱","source":"pass5e-summary","stage":"late","tags":["重新爱","双份爱","锁骨"],"text":"内心独白（意译）：想着即使他忘了，自己也会重新爱他一次，待他恢复记忆、就能得到双份爱；清晨困意中说自己睡不着也控制不住，并以咬他锁骨代替回答害羞的原因，解释为被他摸腿惹的。","type":"inner_monologues"},{"addressee":"自身","chapter":251,"chapter_label":null,"chapter_range":null,"emotion":["不安","坚定"],"id":"inner-251-01","inner":true,"paraphrase":true,"scene":"心里发紧，必须向母亲问清叶凡细节","source":"pass5e-summary","stage":"late","tags":["叶凡","母亲","发紧"],"text":"内心独白（意译）：感到心里发紧、必须向母亲问清叶凡细节。","type":"inner_monologues"},{"addressee":"自身","chapter":252,"chapter_label":null,"chapter_range":null,"emotion":["坚定"],"id":"inner-252-01","inner":true,"paraphrase":true,"scene":"暗下决心要把事情查个水落石出","source":"pass5e-summary","stage":"late","tags":["暗查","决心"],"text":"内心独白（意译）：暗下决心要把事情查个水落石出。","type":"inner_monologues"},{"addressee":"自身","chapter":254,"chapter_label":null,"chapter_range":null,"emotion":["恐惧","关心"],"id":"inner-254-01","inner":true,"paraphrase":true,"scene":"想起他喝百草枯，心脏发紧后怕","source":"pass5e-summary","stage":"late","tags":["百草枯","后怕"],"text":"内心独白（意译）：想起他喝百草枯的事、心脏发紧，后怕若自己晚一步他就真的出事。","type":"inner_monologues"},{"addressee":"自身","chapter":255,"chapter_label":null,"chapter_range":null,"emotion":["害羞","不安"],"id":"inner-255-01","inner":true,"paraphrase":true,"scene":"瞥见避孕套，生理期却想顺手买两盒备用","source":"pass5e-summary","stage":"late","tags":["避孕套","生理期","害羞"],"text":"内心独白（意译）：结账时瞥见避孕套，想着自己生理期、但考虑顺手买两盒备用，又感到害羞；内心决定改在网上买避孕套更稳妥。","type":"inner_monologues"},{"addressee":"自身","chapter":259,"chapter_label":null,"chapter_range":null,"emotion":["毒舌","关心"],"id":"inner-259-01","inner":true,"paraphrase":true,"scene":"骂他傻子，跟病原体待在一起就是慢慢被传染","source":"pass5e-summary","stage":"late","tags":["病原体","传染","母亲"],"text":"内心独白（意译）：骂他傻子，跟病原体待在一起就是慢慢被传染；想起母亲与她接触后当晚也发烧。","type":"inner_monologues"},{"addressee":"自身","chapter":259,"chapter_label":null,"chapter_range":null,"emotion":["害羞","不安"],"id":"inner-259-02","inner":true,"paraphrase":true,"scene":"第一次在男生面前展示身体，怕身材不如他想象","source":"pass5e-summary","stage":"late","tags":["擦背","身材","紧张"],"text":"内心独白（意译）：第一次在男生面前展示身体，又害羞又紧张，怕自己的身材不如他想象、怕让他失望。","type":"inner_monologues"},{"addressee":"自身","chapter":260,"chapter_label":null,"chapter_range":null,"emotion":["调侃","俏皮"],"id":"inner-260-01","inner":true,"paraphrase":true,"scene":"想象他恢复记忆后会羞愧，觉得好笑","source":"pass5e-summary","stage":"late","tags":["恢复记忆","羞愧"],"text":"内心独白（意译）：想象他恢复记忆后会羞愧，觉得好笑。","type":"inner_monologues"},{"addressee":"自身","chapter":263,"chapter_label":null,"chapter_range":null,"emotion":["调侃","疑惑"],"id":"inner-263-01","inner":true,"paraphrase":true,"scene":"暗暗认定他有贼心没贼胆","source":"pass5e-summary","stage":"late","tags":["贼心","贼胆"],"text":"内心独白（意译）：暗暗认定他有贼心没贼胆。","type":"inner_monologues"},{"addressee":"自身","chapter":277,"chapter_label":null,"chapter_range":[277,279],"emotion":["绝望","坚定"],"id":"inner-277-01","inner":true,"paraphrase":true,"scene":"保护性分手之前","source":"pass5a-summary","stage":"late","tags":["保护性分手","威胁短信"],"text":"内心独白（意译）：277–279 章她宁可提分手被恨，也不拿他的命赌；爱他胜过爱自己。","type":"inner_monologues"},{"addressee":"自身","chapter":268,"chapter_label":null,"chapter_range":null,"emotion":["害羞","动摇"],"id":"inner-268-01","inner":true,"paraphrase":true,"scene":"天台视频","source":"pass5f-summary","stage":"late","tags":["星星","脸红"],"text":"内心独白（意译）：祁南夸她眼睛比星星好看时脸红，心想若能与他一起看这一刻该多好。","type":"inner_monologues"},{"addressee":"自身","chapter":269,"chapter_label":null,"chapter_range":null,"emotion":["不安","关心"],"id":"inner-269-01","inner":true,"paraphrase":true,"scene":"深夜视频","source":"pass5f-summary","stage":"late","tags":["挂视频","爬床"],"text":"内心独白（意译）：察觉他情绪转沉而担心；要求别挂视频、想听着他的声音入睡，直言是怕半夜有女人爬上他的床。","type":"inner_monologues"},{"addressee":"自身","chapter":270,"chapter_label":null,"chapter_range":null,"emotion":["自嘲","动摇"],"id":"inner-270-01","inner":true,"paraphrase":true,"scene":"发布会表现","source":"pass5f-summary","stage":"late","tags":["摆拍","谦虚"],"text":"内心独白（意译）：并不认为自己做了什么重要的事，觉得不过是穿漂亮服饰在镜头前摆拍而已。","type":"inner_monologues"},{"addressee":"自身","chapter":270,"chapter_label":null,"chapter_range":null,"emotion":["坚定","恐惧"],"id":"inner-270-02","inner":true,"paraphrase":true,"scene":"委托侦探","source":"pass5f-summary","stage":"late","tags":["幕后黑手","查清"],"text":"内心独白（意译）：希望没有幕后黑手，但为保祁南安全必须查清，否则万一祁南出事她一辈子无法原谅自己。","type":"inner_monologues"},{"addressee":"自身","chapter":275,"chapter_label":null,"chapter_range":null,"emotion":["不安","失落"],"id":"inner-275-01","inner":true,"paraphrase":true,"scene":"等待的一周","source":"pass5f-summary","stage":"late","tags":["数秒","世纪"],"text":"内心独白（意译）：等待的一周过得极慢，每天数着秒度过，像过了一个世纪那样难熬。","type":"inner_monologues"},{"addressee":"自身","chapter":276,"chapter_label":null,"chapter_range":null,"emotion":["调侃","疑惑"],"id":"inner-276-01","inner":true,"paraphrase":true,"scene":"医学生误认","source":"pass5f-summary","stage":"late","tags":["医学生","脑子错乱"],"text":"内心独白（意译）：认定他误认自己是医学生肯定是脑子错乱。","type":"inner_monologues"},{"addressee":"自身","chapter":277,"chapter_label":null,"chapter_range":null,"emotion":["恐惧","绝望"],"id":"inner-277-02","inner":true,"paraphrase":true,"scene":"威胁消息","source":"pass5f-summary","stage":"late","tags":["巨石","安危"],"text":"内心独白（意译）：看到威胁消息后心沉如巨石压得透不过气，判断对方认定她不敢拿在意之人的安危去赌。","type":"inner_monologues"},{"addressee":"自身","chapter":278,"chapter_label":null,"chapter_range":null,"emotion":["绝望","恐惧"],"id":"inner-278-01","inner":true,"paraphrase":true,"scene":"酒店房间回放威胁信息","source":"pass5f-summary","stage":"late","tags":["死局","失忆"],"text":"内心独白（意译）：在酒店房间反复回放威胁信息；认为主动离开比杀了她还难受，但继续留在祁南身边无异于置他于危险之中；想采取行动却连对方是谁都不知道，感觉陷入无解死局；甚至想他一直失忆下去也挺好；感到心脏滴血，无法抑制痛苦情绪。","type":"inner_monologues"},{"addressee":"自身","chapter":279,"chapter_label":null,"chapter_range":null,"emotion":["绝望","坚定"],"id":"inner-279-01","inner":true,"paraphrase":true,"scene":"保护性分手之前","source":"pass5f-summary","stage":"late","tags":["自私","不敢赌"],"text":"内心独白（意译）：知道自己这样做是自私的，但没有办法；因为她爱祁南胜过爱自己，害怕失去他的任何可能，即使自己遍体鳞伤也不想去赌；不敢拿他的命赌；上次仓库因她导致他受伤失忆，绝不让同样事再发生；不惜代价要做保护他的人。","type":"inner_monologues"},{"addressee":"自身","chapter":282,"chapter_label":null,"chapter_range":null,"emotion":["恐惧","绝望"],"id":"inner-282-01","inner":true,"paraphrase":true,"scene":"连城避祸","source":"pass5f-summary","stage":"late","tags":["幕后黑手","恨她"],"text":"内心独白（意译）：觉得幕后黑手在自己身边，所以没回夏家、独自跑到这个没人知晓的地方；知道祁南肯定会恨她，但没办法。","type":"inner_monologues"},{"addressee":"自身","chapter":283,"chapter_label":null,"chapter_range":null,"emotion":["失落","动摇"],"id":"inner-283-01","inner":true,"paraphrase":true,"scene":"连城安顿","source":"pass5f-summary","stage":"late","tags":["住宿","京城人"],"text":"内心独白（意译）：没力气思考住宿的事，愿让叶安苒安排；觉得叶安苒说京城人冷漠的话有些过，但结合她的经历有这种看法也正常。","type":"inner_monologues"},{"addressee":"自身","chapter":284,"chapter_label":null,"chapter_range":null,"emotion":["悲伤","失控"],"id":"inner-284-01","inner":true,"paraphrase":true,"scene":"想喝酒忘记一切","source":"pass5f-summary","stage":"late","tags":["喝酒","忘记"],"text":"内心独白（意译）：想喝酒，醉了就能忘记一切、心里好受些。","type":"inner_monologues"},{"addressee":"自身","chapter":286,"chapter_label":null,"chapter_range":null,"emotion":["悲伤","动摇"],"id":"inner-286-01","inner":true,"paraphrase":true,"scene":"秦时雨说连城是避风港","source":"pass5f-summary","stage":"late","tags":["刺痛","避风港"],"text":"内心独白（意译）：秦时雨说连城是避风港、她也是其中之一时，她心口被刺痛。","type":"inner_monologues"},{"addressee":"自身","chapter":287,"chapter_label":null,"chapter_range":null,"emotion":["调侃","动摇"],"id":"inner-287-01","inner":true,"paraphrase":true,"scene":"安苒与秦时雨别扭","source":"pass5f-summary","stage":"late","tags":["绝配","假装冷漠"],"text":"内心独白（意译）：觉得两人明明心里有对方、却假装冷漠，真是绝配。","type":"inner_monologues"},{"addressee":"自身","chapter":287,"chapter_label":null,"chapter_range":null,"emotion":["恐惧","不安"],"id":"inner-287-02","inner":true,"paraphrase":true,"scene":"想揪出幕后主谋","source":"pass5f-summary","stage":"late","tags":["无力","监视"],"text":"内心独白（意译）：每天都很烦，心里只想揪出幕后主谋，却越想越无力——对方在暗处、自己一举一动被监视，侦探是前车之鉴，再行动可能连累祁南。","type":"inner_monologues"},{"addressee":"自身","chapter":288,"chapter_label":null,"chapter_range":null,"emotion":["悲伤","失落"],"id":"inner-288-01","inner":true,"paraphrase":true,"scene":"看见金毛想起煤团","source":"pass5f-summary","stage":"late","tags":["煤团","金毛"],"text":"内心独白（意译）：看见金毛想起寄养在宠物店的煤团，眼底黯淡。","type":"inner_monologues"},{"addressee":"自身","chapter":288,"chapter_label":null,"chapter_range":null,"emotion":["不安","克制"],"id":"inner-288-02","inner":true,"paraphrase":true,"scene":"做陶艺分散注意力","source":"pass5f-summary","stage":"late","tags":["陶艺","崩溃"],"text":"内心独白（意译）：想找点事做分散注意力，不然脑子胡思乱想迟早崩溃；认真做陶艺时才能稍微缓解焦躁；压抑情绪总有一天会爆发，她没办法只能走一步看一步。","type":"inner_monologues"},{"addressee":"自身","chapter":290,"chapter_label":null,"chapter_range":null,"emotion":["失落","动摇"],"id":"inner-290-01","inner":true,"paraphrase":true,"scene":"海边想起祁南","source":"pass5f-summary","stage":"late","tags":["海景","一起看"],"text":"内心独白（意译）：感叹海景好漂亮时心想，要是能跟祁南一起看就好了。","type":"inner_monologues"},{"addressee":"自身","chapter":290,"chapter_label":null,"chapter_range":null,"emotion":["疑惑","动摇"],"id":"inner-290-02","inner":true,"paraphrase":true,"scene":"安苒落水原因","source":"pass5f-summary","stage":"late","tags":["分心","宋晶"],"text":"内心独白（意译）：她知道叶安苒其实是瞅见秦时雨和宋晶两人才分心失神没站稳。","type":"inner_monologues"},{"addressee":"自身","chapter":291,"chapter_label":null,"chapter_range":null,"emotion":["疑惑","动摇"],"id":"inner-291-01","inner":true,"paraphrase":true,"scene":"安苒与秦时雨别扭","source":"pass5f-summary","stage":"late","tags":["别扭","持续"],"text":"内心独白（意译）：真不知道叶安苒和秦时雨这种别扭状态要持续到什么时候。","type":"inner_monologues"},{"addressee":"自身","chapter":293,"chapter_label":null,"chapter_range":null,"emotion":["悲伤","失落"],"id":"inner-293-01","inner":true,"paraphrase":true,"scene":"安苒突然回京","source":"pass5f-summary","stage":"late","tags":["雪花","融化"],"text":"内心独白（意译）：觉得一切太突然、毫无预兆，像冬天里的雪花落在掌心、很快融化消失。","type":"inner_monologues"},{"addressee":"自身","chapter":295,"chapter_label":null,"chapter_range":null,"emotion":["动摇","疑惑"],"id":"inner-295-01","inner":true,"paraphrase":true,"scene":"重逢壁咚","source":"pass5f-summary","stage":"late","tags":["骂她","反过来"],"text":"内心独白（意译）：她本以为他会骂她，却没想到他反过来骂自己。","type":"inner_monologues"},{"addressee":"自身","chapter":301,"chapter_label":null,"chapter_range":null,"emotion":["害羞","坦白"],"id":"inner-301-01","inner":true,"paraphrase":true,"scene":"蜜月篇2提前透支","source":"pass5f-summary","stage":"late","tags":["正式夫妻","透支"],"text":"内心独白（意译）：反正明天领完证就是正式夫妻，今晚顶多算提前透支。","type":"inner_monologues"},{"addressee":"自身","chapter":302,"chapter_label":null,"chapter_range":null,"emotion":["温柔","动摇"],"id":"inner-302-01","inner":true,"paraphrase":true,"scene":"分别后更珍惜","source":"pass5f-summary","stage":"late","tags":["珍惜","分开"],"text":"内心独白（意译）：这段分别让她更珍惜与祁南相处时光，每一分每一秒都不想分开。","type":"inner_monologues"},{"addressee":"自身","chapter":303,"chapter_label":null,"chapter_range":null,"emotion":["调侃","吃醋"],"id":"inner-303-01","inner":true,"paraphrase":true,"scene":"背头轻声嘀咕","source":"pass5f-summary","stage":"late","tags":["背头","招蜂引蝶"],"text":"内心独白（意译）：轻声嘀咕：祁南梳背头像斯文败类，仅此一次、以后不能让他再搞这种东西，不然在人群中太显眼、指不定又要招蜂引蝶。","type":"inner_monologues"},{"addressee":"自身","chapter":303,"chapter_label":null,"chapter_range":null,"emotion":["坚定","动摇"],"id":"inner-303-02","inner":true,"paraphrase":true,"scene":"民政局领证","source":"pass5f-summary","stage":"late","tags":["等太久","阿嫲"],"text":"内心独白（意译）：这一刻她等太久了；只要今天领了证，自己就成为他的妻子、他也将永远属于自己；签下名字时才真切意识到两人将成为法律意义上的夫妻；心中默念：阿嫲当初说的那个能守护她一辈子的人，小柒好像找到了。","type":"inner_monologues"},{"addressee":"自身","chapter":304,"chapter_label":null,"chapter_range":null,"emotion":["不安","动摇"],"id":"inner-304-01","inner":true,"paraphrase":true,"scene":"患得患失","source":"pass5f-summary","stage":"late","tags":["患得患失","太爱"],"text":"内心独白（意译）：她不否认自己患得患失，但这是因为太爱他——越重视的东西越害怕失去。","type":"inner_monologues"}],"paraphrase_only":true,"schema_version":"1.0.0","updated":"2026-11-06"}